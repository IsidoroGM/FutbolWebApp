// C:\DataFlex Projects\FutbolWebApp\AppSrc\SelectPosicion.wo
// SelectPosicion
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg

Use ZoomPosicion.wo
Use cposicionDataDictionary.dd

Object oSelectPosicion is a cWebView
    Set psCaption to "SelectPosicion"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False
    Set piMaxWidth to 1024

    Object oposicion_DD is a cposicionDataDictionary
    End_Object 

    Set Main_DD to oposicion_DD
    Set Server  to oposicion_DD


    Object oList is a cWebList
        Set piColumnSpan to 0
        Set psCSSClass to "MobileList"
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set pbShowHeader to False
        Set piSortColumn to 0

        Object oposicionNombre is a cWebColumn
            Entry_Item posicion.Nombre
            Set psCaption to "posicion.Nombre"
            Set piWidth to 500
        End_Object 

        Object oDetailButton is a cWebColumnButton
            Set psCaption to "btn"
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignRight


            // Navegación desde el botón de detalle hacia el Zoom de Posición.
            WebRegisterPath ntNavigateForward oZoomPosicion

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                // El botón de detalle abre el registro en modo consulta.
                Move True to NavigateData.bReadOnly
            End_Procedure

        End_Object 


        // La selección de una fila debe abrir el Zoom de Posición, no otra vista Select.
        WebRegisterPath ntNavigateForward oZoomPosicion

        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromParent)
                    // Si llegamos desde una vista padre, avanzamos al detalle de la posición seleccionada.
                    Send NavigateForward of oZoomPosicion Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromChild)
                    // Si la vista se usa como selector desde un Zoom hijo, devolvemos el registro seleccionado.
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    // Si se usa como búsqueda principal, cerramos devolviendo la selección al invocador.
                    Send NavigateClose Self
                    Case Break

                Case Else // must be nfUndefined
                    // Acceso directo al listado: abrir el Zoom de la posición seleccionada.
                    Send NavigateForward of oZoomPosicion Self
                    Case Break
            Case End
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            // La navegación por fila abre el Zoom en modo solo lectura.
            Move True to NavigateData.bReadOnly
        End_Procedure

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Search"

            Procedure OnClick
                Send Search of oList
            End_Procedure

        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "New"

            // Navegación para crear una nueva posición desde el listado.
            WebRegisterPath ntNavigateForward oZoomPosicion

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                // Indicamos al Zoom que debe abrirse preparando un registro nuevo.
                Move True to NavigateData.bNewRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        WebSet pbRender of oNewButton to True
        WebSet pbRender of oDetailButton to True

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // Entrada desde una vista padre: mantenemos visible el botón de detalle.
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // Entrada desde un Zoom hijo: la vista funciona como selector de posición.
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // Entrada como prompt/búsqueda: se oculta el detalle para devolver solo la selección.
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else // must be nfUndefined
                // Entrada directa al listado: permitimos abrir el Zoom desde la fila o el botón.

        Case End

    End_Procedure


End_Object 
