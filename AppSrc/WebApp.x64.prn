37913>>>                // If from parent, this is a constrained drill down.
37913>>>                Case Break
37914>>>
37914>>>            Case (NavigateData.eNavigateType = nfFromChild)
37917>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37917>>>                Case Break
37918>>>
37918>>>            Case Else // must be nfUndefined
37918>>>
37918>>>        Case End
37918>>>
37918>>>        Send SetActionButtons
37919>>>
37919>>>    End_Procedure
37920>>>
37920>>>End_Object 
