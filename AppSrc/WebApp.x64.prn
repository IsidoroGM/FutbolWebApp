38480>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38480>>>                Case Break
38481>>>
38481>>>            Case Else // must be nfUndefined
38481>>>
38481>>>        Case End
38481>>>
38481>>>        Send SetActionButtons
