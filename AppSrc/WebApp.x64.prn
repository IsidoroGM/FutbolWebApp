37761>>>    Procedure SetActionButtons
37764>>>        tWebNavigateData NavigateData
37764>>>        tWebNavigateData NavigateData
37764>>>        Boolean bHasRecord
37764>>>        Handle hoDD
37764>>>
37764>>>        Get Server to hoDD
37765>>>        Get GetNavigateData to NavigateData
37766>>>        Get HasRecord of hoDD to bHasRecord
37767>>>
37767>>>        // let's hide all buttons and then Show the ones we want
37767>>>        WebSet pbRender of oEditBtn to False
37768>>>        WebSet pbRender of oSaveBtn to False
37769>>>        WebSet pbRender of oCancelChangesBtn to False
37770>>>        WebSet pbRender of oDeleteBtn to False
37771>>>
37771>>>        If (NavigateData.bReadOnly) Begin
37773>>>            WebSet pbRender of oEditBtn to True
37774>>>        End
37774>>>>
37774>>>        Else Begin
37775>>>            WebSet pbRender of oSaveBtn to True
37776>>>            WebSet pbRender of oCancelChangesBtn to True
37777>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37778>>>        End
37778>>>>
37778>>>    End_Procedure
