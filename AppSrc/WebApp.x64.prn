38054>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38057>>>>>>>        Case Begin
38057>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38059>>>>>>>                // Entrada desde una navegación principal.
38059>>>>>>>                // Ejemplo: SelectLiga abre ZoomLiga para consultar una liga.
38059>>>>>>>                Case Break
38060>>>>>>>
38060>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38063>>>>>>>                // Entrada desde una vista padre.
38063>>>>>>>                // Liga suele ser entidad raíz, así que normalmente no aplicamos filtros aquí.
38063>>>>>>>                Case Break
38064>>>>>>>
38064>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38067>>>>>>>                // Entrada desde una vista hija.
38067>>>>>>>                // Puede ocurrir si otra vista necesita consultar la liga asociada.
38067>>>>>>>                Case Break
38068>>>>>>>
38068>>>>>>>            Case Else // must be nfUndefined
38068>>>>>>>                // Entrada sin contexto de navegación definido.
38068>>>>>>>                // No aplicamos comportamiento especial.
38068>>>>>>>                Case Break
38069>>>>>>>        Case End
38069>>>>>>>
38069>>>>>>>        // Actualizamos la visibilidad de botones según el modo de navegación.
38069>>>>>>>        Send SetActionButtons
38070>>>>>>>    End_Procedure
38071>>>>>>>
38071>>>>>>>End_Object
