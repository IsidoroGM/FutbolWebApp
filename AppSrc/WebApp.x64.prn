38022>>>>>>>    Procedure SetActionButtons
38025>>>>>>>        tWebNavigateData NavigateData
38025>>>>>>>        tWebNavigateData NavigateData
38025>>>>>>>        Boolean bHasRecord
38025>>>>>>>        Handle hoDD
38025>>>>>>>    
38025>>>>>>>        Get Server to hoDD
38026>>>>>>>        Get GetNavigateData to NavigateData
38027>>>>>>>        Get HasRecord of hoDD to bHasRecord
38028>>>>>>>    
38028>>>>>>>        WebSet pbRender of oEditBtn to False
38029>>>>>>>        WebSet pbRender of oSaveBtn to False
38030>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38031>>>>>>>        WebSet pbRender of oDeleteBtn to False
38032>>>>>>>        WebSet pbRender of oBtnVerEquipos to False
38033>>>>>>>    
38033>>>>>>>        If (NavigateData.bReadOnly) Begin
38035>>>>>>>            WebSet pbRender of oEditBtn to True
38036>>>>>>>    
38036>>>>>>>            // Solo mostramos el botón cuando existe una liga cargada.
38036>>>>>>>            If (bHasRecord) Begin
38038>>>>>>>                WebSet pbRender of oBtnVerEquipos to True
38039>>>>>>>            End
38039>>>>>>>>
38039>>>>>>>        End
38039>>>>>>>>
38039>>>>>>>        Else Begin
38040>>>>>>>            WebSet pbRender of oSaveBtn to True
38041>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38042>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38043>>>>>>>        End
38043>>>>>>>>
38043>>>>>>>    End_Procedure
