36750>>>>>>>    End_Function
36751>>>>>>>    
36751>>>>>>>    Function Base64EncodeArr UChar[] ucaBuffer Returns String
36753>>>>>>>        Integer iErr
36753>>>>>>>        Pointer pBase64
36753>>>>>>>        String sBase64
36753>>>>>>>        Move (Base64Encode(AddressOf(ucaBuffer), SizeOfArray(ucaBuffer))) to pBase64
36754>>>>>>>        If (not(pBase64)) Begin
36756>>>>>>>            Function_Return sBase64
36757>>>>>>>        End
36757>>>>>>>>
36757>>>>>>>        Move (PointerToString(pBase64)) to sBase64
36758>>>>>>>        Move (Free(pBase64)) to iErr
36759>>>>>>>        Function_Return sBase64
36760>>>>>>>    End_Function
36761>>>>>>>    
36761>>>>>>>    Function Base64DecodeArr String sBase64 Returns UChar[]
36763>>>>>>>        Integer iLen
36763>>>>>>>        Pointer pBase64
36763>>>>>>>        UChar[] ucaBuffer
36764>>>>>>>        Move (Base64Decode(AddressOf(sBase64), &iLen)) to pBase64
36765>>>>>>>        If (not(pBase64)) Begin
36767>>>>>>>            Function_Return ucaBuffer
36768>>>>>>>        End
36768>>>>>>>>
36768>>>>>>>        
36768>>>>>>>        Move (ResizeArray(ucaBuffer, iLen)) to ucaBuffer
36769>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36770>>>>>>>        Move (Free(pBase64)) to iLen
36771>>>>>>>        Function_Return ucaBuffer
36772>>>>>>>    End_Function
36773>>>>>>>    
36773>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36775>>>>>>>        Boolean bOk bRequireTimeCost
36775>>>>>>>        UChar[] ucaHash
36776>>>>>>>        
36776>>>>>>>        Case Begin
36776>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36778>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36779>>>>>>>                If (not(bOk)) Function_Return False
36782>>>>>>>                
36782>>>>>>>                Move True to bRequireTimeCost
36783>>>>>>>                Case Break
36784>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36787>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36788>>>>>>>                If (not(bOk)) Function_Return False
36791>>>>>>>                
36791>>>>>>>                Move True to bRequireTimeCost
36792>>>>>>>                Case Break
36793>>>>>>>            Case Else
36793>>>>>>>                Error 8710 "Invalid algorithm selected."
36794>>>>>>>>
36794>>>>>>>                Function_Return False
36795>>>>>>>        Case End
36795>>>>>>>        
36795>>>>>>>        String sSalt
36795>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36796>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36799>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36800>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36803>>>>>>>        
36803>>>>>>>        If (bRequireTimeCost) Begin
36805>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36806>>>>>>>        End
36806>>>>>>>>
36806>>>>>>>        Else Begin
36807>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36808>>>>>>>        End
36808>>>>>>>>
36808>>>>>>>        
36808>>>>>>>        Function_Return bOk
36809>>>>>>>    End_Function
36810>>>>>>>    
36810>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36812>>>>>>>        UChar[] ucaSalt
36813>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36814>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36817>>>>>>>        
36817>>>>>>>        If (num_arguments > 4) Begin
36819>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36820>>>>>>>        End
36820>>>>>>>>
36820>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36821>>>>>>>    End_Function
36822>>>>>>>    
36822>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36824>>>>>>>        Boolean bRequiresTimeCost
36824>>>>>>>        UInteger uiAlgo uiTimeCost
36824>>>>>>>        Integer iBegin iEnd
36824>>>>>>>        String sSalt
36824>>>>>>>        
36824>>>>>>>        Move 1 to iBegin
36825>>>>>>>        
36825>>>>>>>        // Parse Algo
36825>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36826>>>>>>>        If (not(iEnd)) Function_Return False
36829>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36830>>>>>>>        
36830>>>>>>>        // Parse Salt
36830>>>>>>>        Move (iEnd + 1) to iBegin
36831>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36832>>>>>>>        If (not(iEnd)) Function_Return False
36835>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36836>>>>>>>        
36836>>>>>>>        Case Begin
36836>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36838>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36841>>>>>>>                Move True to bRequiresTimeCost
36842>>>>>>>                Case Break
36843>>>>>>>            Case Else
36843>>>>>>>                Error 8710 "Invalid algorithm selected."
36844>>>>>>>>
36844>>>>>>>                Function_Return False
36845>>>>>>>        Case End
36845>>>>>>>        
36845>>>>>>>        // Parse optional timecost
36845>>>>>>>        If (bRequiresTimeCost) Begin
36847>>>>>>>            Move (iEnd + 1) to iBegin
36848>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36849>>>>>>>            If (not(iEnd)) Function_Return False
36852>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36853>>>>>>>        End
36853>>>>>>>>
36853>>>>>>>        
36853>>>>>>>        // Parse rest hash
36853>>>>>>>        Move (iEnd + 1) to iBegin
36854>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36855>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36858>>>>>>>        
36858>>>>>>>        // Base64Decode
36858>>>>>>>        UChar[] ucaSalt
36859>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36860>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36863>>>>>>>        
36863>>>>>>>        // Create new hash
36863>>>>>>>        String sNewHash
36863>>>>>>>        If (bRequiresTimeCost) Begin
36865>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36867>>>>>>>                Function_Return False 
36868>>>>>>>            End
36868>>>>>>>>
36868>>>>>>>        End
36868>>>>>>>>
36868>>>>>>>        Else Begin
36869>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36871>>>>>>>                Function_Return False 
36872>>>>>>>            End
36872>>>>>>>>
36872>>>>>>>        End
36872>>>>>>>>
36872>>>>>>>        Function_Return (sNewHash = sHash)
36873>>>>>>>    End_Function
36874>>>>>>>    
36874>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36876>>>>>>>        Boolean bRequireTimeCost
36876>>>>>>>        UBigInt ullSize
36876>>>>>>>        UChar[] ucaSalt
36877>>>>>>>        String sSalt
36877>>>>>>>        
36877>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36878>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36879>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36882>>>>>>>        
36882>>>>>>>        Case Begin
36882>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36884>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36885>>>>>>>                Move True to bRequireTimeCost
36886>>>>>>>                Case Break
36887>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36890>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36891>>>>>>>                Move True to bRequireTimeCost
36892>>>>>>>                Case Break
36893>>>>>>>            Case Else
36893>>>>>>>                Error 8710 "Invalid algorithm selected."
36894>>>>>>>>
36894>>>>>>>                Function_Return 0
36895>>>>>>>        Case End
36895>>>>>>>        
36895>>>>>>>        // calculate base64 in a non-floating-manner
36895>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36896>>>>>>>        
36896>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36897>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36898>>>>>>>        If (bRequireTimeCost) Begin
36900>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36901>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36902>>>>>>>        End
36902>>>>>>>>
36902>>>>>>>        Else Begin
36903>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36904>>>>>>>        End
36904>>>>>>>>
36904>>>>>>>        
36904>>>>>>>        Function_Return ullSize
36905>>>>>>>    End_Function
36906>>>>>>>End_Class
36907>>>>>>>
36907>>>>>>>Class cPasswordHasher is a cObject
36908>>>>>>>    
36908>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36909>>>>>>>    
36909>>>>>>>    Procedure Construct_Object
36911>>>>>>>        Forward Send Construct_Object
36913>>>>>>>        
36913>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36914>>>>>>>        Property UInteger   puiSaltSize         16
36915>>>>>>>        
36915>>>>>>>        Property UInteger   puiOptTimeCost      420000
36916>>>>>>>    End_Procedure
36917>>>>>>>    
36917>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36919>>>>>>>        Boolean bOk
36919>>>>>>>        UInteger uiAlgo
36919>>>>>>>        Get peAlgorithm to uiAlgo
36920>>>>>>>        
36920>>>>>>>        Case Begin
36920>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36922>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36925>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36926>>>>>>>                Case Break
36927>>>>>>>            Case Else
36927>>>>>>>                Error 8710 "Invalid algorithm selected."
36928>>>>>>>>
36928>>>>>>>                Function_Return False
36929>>>>>>>        Case End
36929>>>>>>>        
36929>>>>>>>        Function_Return bOk
36930>>>>>>>    End_Function
36931>>>>>>>    
36931>>>>>>>    Function RequiredBufferSize Returns UBigInt
36933>>>>>>>        UBigInt ullSize
36933>>>>>>>        UInteger uiAlgo
36933>>>>>>>        Get peAlgorithm to uiAlgo
36934>>>>>>>        
36934>>>>>>>        Case Begin
36934>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36936>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36939>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36940>>>>>>>                Case Break
36941>>>>>>>            Case Else
36941>>>>>>>                Error 8710 "Invalid algorithm selected."
36942>>>>>>>>
36942>>>>>>>                Function_Return 0
36943>>>>>>>        Case End
36943>>>>>>>        
36943>>>>>>>        Function_Return ullSize
36944>>>>>>>    End_Function
36945>>>>>>>
36945>>>>>>>End_Class
36946>>>>>
36946>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36947>>>>>    
36947>>>>>    Procedure Construct_Object
36949>>>>>        Handle hoObj
36949>>>>>        
36949>>>>>        Forward Send Construct_Object
36951>>>>>        
36951>>>>>        Set pbSessionCookieHttpOnly to True
36952>>>>>        
36952>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36953>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36954>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36955>>>>>        
36955>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36956>>>>>        Set phoUserDD to hoObj
36957>>>>>        
36957>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36958>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36959>>>>>        Set phoSessionDD to hoObj
36960>>>>>        
36960>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36961>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36962>>>>>        Set phoCrypto to hoObj
36963>>>>>        
36963>>>>>        Property Boolean pbPasswordHashing True
36964>>>>>        
36964>>>>>        Property Boolean pbCreatingNewSession False
36965>>>>>        Property String psLoginName
36966>>>>>        Property String psUserName ""
36967>>>>>        Property Integer piUserRights 0
36968>>>>>    End_Procedure
36969>>>>>    
36969>>>>>    Procedure End_Construct_Object
36971>>>>>        Forward Send End_Construct_Object
36973>>>>>        
36973>>>>>        Handle hoCrypto
36973>>>>>        Integer iFieldLen
36973>>>>>        If (pbPasswordHashing(Self)) Begin
36975>>>>>            Get phoCrypto to hoCrypto
36976>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36979>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36981>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36982>>>>>>
36982>>>>>            End
36982>>>>>>
36982>>>>>        End
36982>>>>>>
36982>>>>>    End_Procedure
36983>>>>>    
36983>>>>>    Function CreateSession String sRemoteAddress Returns String
36985>>>>>        String sSessionKey
36985>>>>>        Integer iErr
36985>>>>>        Boolean bLogWebSession
36985>>>>>        Handle hoSessionDD       
36985>>>>>        Get phoSessionDD to hoSessionDD
36986>>>>>        
36986>>>>>        //  Get session key
36986>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36988>>>>>        
36988>>>>>        Get pbLogWebSession to bLogWebSession
36989>>>>>        If not bLogWebSession Begin
36991>>>>>            Function_Return sSessionKey        
36992>>>>>        End
36992>>>>>>
36992>>>>>
36992>>>>>        //  Store session
36992>>>>>        Send Clear of hoSessionDD
36993>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36994>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36995>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36996>>>>>        Get Request_Validate of hoSessionDD to iErr
36997>>>>>        If (iErr) Begin
36999>>>>>            // this should not happen. If it does its a programming error
36999>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37000>>>>>>
37000>>>>>            Function_Return ""
37001>>>>>        End
37001>>>>>>
37001>>>>>        Send Request_Save of hoSessionDD
37002>>>>>        If (Err) Begin
37004>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
37004>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
37005>>>>>>
37005>>>>>            Function_Return ""
37006>>>>>        End
37006>>>>>>
37006>>>>>       
37006>>>>>        Function_Return sSessionKey        
37007>>>>>    End_Function
37008>>>>>    
37008>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
37010>>>>>        DateTime dtLastAccess dtCurrent
37010>>>>>        TimeSpan tsDiff
37010>>>>>        Integer iErr iSessionTimeout iSpanMinutes
37010>>>>>        Boolean bResult bCreatingNewSession
37010>>>>>        Boolean bLogWebSession bLoadWebApp
37010>>>>>        Integer eLoginMode
37010>>>>>        String sTime
37010>>>>>        Handle hoSessionDD hoUserDD       
37010>>>>>        
37010>>>>>        Move False to bLoadWebApp
37011>>>>>        If (num_arguments >= 2) Begin
37013>>>>>            Move bOptLoadWebApp to bLoadWebApp
37014>>>>>        End
37014>>>>>>
37014>>>>>        
37014>>>>>        Get phoSessionDD to hoSessionDD
37015>>>>>        Get phoUserDD to hoUserDD
37016>>>>>        
37016>>>>>        Get pbLogWebSession to bLogWebSession
37017>>>>>        Get peLoginMode to eLoginMode
37018>>>>>        
37018>>>>>        // for this object, you can only disable logging if login completely is disabled
37018>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
37020>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
37021>>>>>>
37021>>>>>            Function_Return False
37022>>>>>        End
37022>>>>>>
37022>>>>>
37022>>>>>        //  Clear session properties
37022>>>>>        Set psSessionKey to ""
37023>>>>>        Send UpdateSessionProperties True
37024>>>>>        
37024>>>>>        If not bLogWebSession Begin
37026>>>>>            Forward Get ValidateSession sSessionKey to bResult
37028>>>>>            Function_Return bResult
37029>>>>>        End        
37029>>>>>>
37029>>>>>        
37029>>>>>        Move False to bResult
37030>>>>>        Get piSessionTimeout to iSessionTimeout 
37031>>>>>        
37031>>>>>        //  Check if session exists
37031>>>>>        Send Clear of hoSessionDD
37032>>>>>        Move sSessionKey to WebAppSession.SessionKey
37033>>>>>        Send Find of hoSessionDD EQ Index.1
37034>>>>>            
37034>>>>>        If (Found) Begin
37036>>>>>            //  Calculate timespan between now and last access time
37036>>>>>            Move (CurrentDateTime()) to dtCurrent
37037>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
37038>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
37039>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
37040>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
37041>>>>>            
37041>>>>>            //  Check if session didn't time out
37041>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
37043>>>>>                Forward Get ValidateSession sSessionKey to bResult
37045>>>>>                   
37045>>>>>                If (bResult) Begin
37047>>>>>                    //  Update session record
37047>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
37048>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
37049>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
37050>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
37051>>>>>                    Get Request_Validate of hoSessionDD to iErr
37052>>>>>                    If (iErr) Begin
37054>>>>>                        // this should not happen. If it does its a programming error
37054>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37055>>>>>>
37055>>>>>                        Function_Return False
37056>>>>>                    End
37056>>>>>>
37056>>>>>                    Send Request_Save of hoSessionDD
37057>>>>>                    
37057>>>>>                    //  Update user properties
37057>>>>>                    Send UpdateSessionProperties False
37058>>>>>                End
37058>>>>>>
37058>>>>>            End
37058>>>>>>
37058>>>>>            Else Begin
37059>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
37059>>>>>                Get pbCreatingNewSession to bCreatingNewSession
37060>>>>>                
37060>>>>>                If (not(bCreatingNewSession)) Begin
37062>>>>>                    If (not(bLoadWebApp)) Begin
37064>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
37065>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
37066>>>>>>
37066>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37067>>>>>                    End
37067>>>>>>
37067>>>>>                    Else Begin
37068>>>>>                        Set pbCreatingNewSession to True                    
37069>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37070>>>>>                        Set pbCreatingNewSession to False                        
37071>>>>>                    End
37071>>>>>>
37071>>>>>                End
37071>>>>>>
37071>>>>>            End
37071>>>>>>
37071>>>>>        End
37071>>>>>>
37071>>>>>        Else Begin
37072>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37073>>>>>>
37073>>>>>        End
37073>>>>>>
37073>>>>>        
37073>>>>>        Function_Return bResult
37074>>>>>    End_Function
37075>>>>>    
37075>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37077>>>>>        If (not(pbPasswordHashing(Self))) Begin
37079>>>>>            Move sPassword to sHash
37080>>>>>            Function_Return True
37081>>>>>        End
37081>>>>>>
37081>>>>>        
37081>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37083>>>>>            Function_Return False
37084>>>>>        End
37084>>>>>>
37084>>>>>        Move ("V1$" + sHash) to sHash
37085>>>>>        Function_Return True
37086>>>>>    End_Function
37087>>>>>    
37087>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37089>>>>>        If (not(pbPasswordHashing(Self))) Begin
37091>>>>>            Move False to bShouldUpgrade
37092>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37093>>>>>        End
37093>>>>>>
37093>>>>>        
37093>>>>>        String sVersion
37093>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37094>>>>>        If (sVersion = "V1$") Begin
37096>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37099>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37100>>>>>        End
37100>>>>>>
37100>>>>>        Else Begin
37101>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37104>>>>>            Function_Return False
37105>>>>>        End
37105>>>>>>
37105>>>>>    End_Function
37106>>>>>    
37106>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37108>>>>>        Handle hoUserDD
37108>>>>>        Integer iErr
37108>>>>>        Get phoUserDD to hoUserDD
37109>>>>>        
37109>>>>>        //  Find the user
37109>>>>>        Send Clear of hoUserDD
37110>>>>>        Move sLoginName to WebAppUser.LoginName
37111>>>>>        Send Find of hoUserDD EQ Index.1
37112>>>>>        If (Found) Begin
37114>>>>>            Send Clear of hoUserDD
37115>>>>>            Function_Return False
37116>>>>>        End
37116>>>>>>
37116>>>>>        
37116>>>>>        Send Clear of hoUserDD
37117>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37118>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37119>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37121>>>>>            Send Clear of hoUserDD
37122>>>>>            Function_Return False
37123>>>>>        End
37123>>>>>>
37123>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37124>>>>>        Get Request_Validate of hoUserDD to iErr
37125>>>>>        If (iErr) Begin
37127>>>>>            Send Clear of hoUserDD
37128>>>>>            Function_Return False
37129>>>>>        End
37129>>>>>>
37129>>>>>        
37129>>>>>        Send Request_Save of hoUserDD
37130>>>>>        Function_Return (not(Err))
37131>>>>>    End_Function
37132>>>>>    
37132>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37134>>>>>        String sSessionKey sUserPassword
37134>>>>>        Handle hoSessionDD hoUserDD
37134>>>>>        Boolean bMatch bUpgrade
37134>>>>>        
37134>>>>>        Get phoSessionDD to hoSessionDD
37135>>>>>        Get phoUserDD to hoUserDD
37136>>>>>        Integer iErr eLoginMode
37136>>>>>        
37136>>>>>        // Refind session record
37136>>>>>        Get psSessionKey to sSessionKey
37137>>>>>        Send Clear of hoSessionDD
37138>>>>>        Move sSessionKey to WebAppSession.SessionKey
37139>>>>>        Send Find of hoSessionDD EQ Index.1
37140>>>>>        
37140>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37142>>>>>            Get peLoginMode to eLoginMode
37143>>>>>            
37143>>>>>            //  Find the user
37143>>>>>            Move sLoginName to WebAppUser.LoginName
37144>>>>>            Send Find of hoUserDD EQ Index.1
37145>>>>>            
37145>>>>>            // Check username and password
37145>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37147>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37148>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37149>>>>>                
37149>>>>>                If (bMatch) Begin
37151>>>>>                    // Store the login
37151>>>>>                    If (bUpgrade) Begin
37153>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37154>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37157>>>>>                    End
37157>>>>>>
37157>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37158>>>>>                    Get Request_Validate of hoSessionDD to iErr
37159>>>>>                    If (iErr) Begin
37161>>>>>                        // this should not happen. If it does its a programming error
37161>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37162>>>>>>
37162>>>>>                        Function_Return False
37163>>>>>                    End
37163>>>>>>
37163>>>>>                    
37163>>>>>                    Send Request_Save of hoSessionDD
37164>>>>>                    
37164>>>>>                    // Update session properties
37164>>>>>                    Send UpdateSessionProperties False
37165>>>>>                    Send NotifyChangeRights
37166>>>>>                    Function_Return True
37167>>>>>                End
37167>>>>>>
37167>>>>>                Else Begin
37168>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37168>>>>>                    Send Clear of hoUserDD
37169>>>>>                End
37169>>>>>>
37169>>>>>            End
37169>>>>>>
37169>>>>>            Else Begin
37170>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37170>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37171>>>>>            End
37171>>>>>>
37171>>>>>        End
37171>>>>>>
37171>>>>>        Else Begin
37172>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37172>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37173>>>>>        End
37173>>>>>>
37173>>>>>          
37173>>>>>        Function_Return False
37174>>>>>    End_Function
37175>>>>>    
37175>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37177>>>>>        Handle hoUserDD
37177>>>>>        Integer iErr
37177>>>>>        Get phoUserDD to hoUserDD
37178>>>>>        
37178>>>>>        //  Find the user
37178>>>>>        Send Clear of hoUserDD
37179>>>>>        Move sLoginName to WebAppUser.LoginName
37180>>>>>        Send Find of hoUserDD EQ Index.1
37181>>>>>        If (not(Found)) Begin
37183>>>>>            Send Clear of hoUserDD
37184>>>>>            Function_Return False
37185>>>>>        End
37185>>>>>>
37185>>>>>        
37185>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37187>>>>>            Send Clear of hoUserDD
37188>>>>>            Function_Return False
37189>>>>>        End
37189>>>>>>
37189>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37190>>>>>        Get Request_Validate of hoUserDD to iErr
37191>>>>>        If (iErr) Begin
37193>>>>>            Send Clear of hoUserDD
37194>>>>>            Function_Return False
37195>>>>>        End
37195>>>>>>
37195>>>>>        
37195>>>>>        Send Request_Save of hoUserDD
37196>>>>>        Function_Return (not(Err))
37197>>>>>    End_Function
37198>>>>>    
37198>>>>>    Function IsLoggedIn Returns Boolean
37200>>>>>        String sLoginName
37200>>>>>        Boolean bLogWebSession bLoggedIn
37200>>>>>        
37200>>>>>        Get pbLogWebSession to bLogWebSession
37201>>>>>        If not bLogWebSession Begin
37203>>>>>            Forward Get IsLoggedIn to bLoggedIn
37205>>>>>            Function_Return bLoggedIn
37206>>>>>        End
37206>>>>>>
37206>>>>>        
37206>>>>>        Get psLoginName to sLoginName
37207>>>>>        
37207>>>>>        Function_Return (sLoginName <> "")
37208>>>>>    End_Function
37209>>>>>    
37209>>>>>    
37209>>>>>    //
37209>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37209>>>>>    // update properties based on the session and user data. Augment this function to update 
37209>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37209>>>>>    // the right records when this procedure is called.
37209>>>>>    //
37209>>>>>    // Params:
37209>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37209>>>>>    //
37209>>>>>    Procedure UpdateSessionProperties Boolean bClear
37211>>>>>        Handle hoUserDD
37211>>>>>        
37211>>>>>        Get phoUserDD to hoUserDD
37212>>>>>        
37212>>>>>        //  Update user properties
37212>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37214>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37215>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37216>>>>>            Set piUserRights to WebAppUser.Rights
37217>>>>>            
37217>>>>>            Send OnSessionPropertiesSet 
37218>>>>>        End
37218>>>>>>
37218>>>>>        Else Begin
37219>>>>>            Set psUsername to ""
37220>>>>>            Set psLoginName to ""
37221>>>>>            Set piUserRights to 0
37222>>>>>            
37222>>>>>            Send OnSessionPropertiesClear
37223>>>>>        End
37223>>>>>>
37223>>>>>    End_Procedure
37224>>>>>    
37224>>>>>    Procedure OnSessionPropertiesSet
37226>>>>>        //  Empty event stub
37226>>>>>    End_Procedure
37227>>>>>    
37227>>>>>    Procedure OnSessionPropertiesClear
37229>>>>>        //  Empty event stub
37229>>>>>    End_Procedure
37230>>>>>    
37230>>>>>    Procedure EndSession
37232>>>>>        Integer iErr
37232>>>>>        Boolean bLogWebSession
37232>>>>>        Handle hoSessionDD       
37232>>>>>        
37232>>>>>        Get phoSessionDD to hoSessionDD
37233>>>>>        Get pbLogWebSession to bLogWebSession
37234>>>>>        If not bLogWebSession Begin
37236>>>>>            Forward Send EndSession
37238>>>>>            Procedure_Return
37239>>>>>        End
37239>>>>>>
37239>>>>>            
37239>>>>>        //  Check if session exists
37239>>>>>        Send Clear of hoSessionDD
37240>>>>>        Get psSessionKey to WebAppSession.SessionKey
37241>>>>>        
37241>>>>>        Send Find of hoSessionDD EQ Index.1
37242>>>>>        If (Found) Begin
37244>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37245>>>>>            Get Request_Validate of hoSessionDD to iErr
37246>>>>>            If (iErr) Begin
37248>>>>>                // this should not happen. If it does its a programming error
37248>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37249>>>>>>
37249>>>>>                Procedure_Return
37250>>>>>            End
37250>>>>>>
37250>>>>>            Send Request_Save of hoSessionDD
37251>>>>>        End
37251>>>>>>
37251>>>>>    End_Procedure
37252>>>>>
37252>>>>>End_Class
37253>>>>>
