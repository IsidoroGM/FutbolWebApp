37743>>>>>>>>>>>        Case Begin
37743>>>>>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37745>>>>>>>>>>>                // Entrada desde SelectEquipo como búsqueda principal: se muestra el equipo seleccionado.
37745>>>>>>>>>>>                Case Break
37746>>>>>>>>>>>
37746>>>>>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37749>>>>>>>>>>>                // Entrada desde una vista padre: el equipo queda condicionado por la liga de origen.
37749>>>>>>>>>>>                Case Break
37750>>>>>>>>>>>
37750>>>>>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37753>>>>>>>>>>>                // Entrada desde una vista hija o prompt: este Zoom actúa como destino de retorno.
37753>>>>>>>>>>>                Case Break
37754>>>>>>>>>>>
37754>>>>>>>>>>>            Case Else // must be nfUndefined
37754>>>>>>>>>>>                // Entrada directa o personalizada: no requiere redirección adicional.
37754>>>>>>>>>>>
37754>>>>>>>>>>>        Case End
37754>>>>>>>>>>>
37754>>>>>>>>>>>        Send SetActionButtons
37755>>>>>>>>>>>
37755>>>>>>>>>>>    End_Procedure
