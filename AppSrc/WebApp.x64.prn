37660>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37663>>>>>>>        Case Begin
37663>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37665>>>>>>>                // Entrada desde una navegación principal.
37665>>>>>>>                // Ejemplo: SelectLiga abre ZoomLiga para consultar una liga.
37665>>>>>>>                Case Break
37666>>>>>>>
37666>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37669>>>>>>>                // Entrada desde una vista padre.
37669>>>>>>>                // Liga suele ser entidad raíz, así que normalmente no aplicamos filtros aquí.
37669>>>>>>>                Case Break
37670>>>>>>>
37670>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37673>>>>>>>                // Entrada desde una vista hija.
37673>>>>>>>                // Puede ocurrir si otra vista necesita consultar la liga asociada.
37673>>>>>>>                Case Break
37674>>>>>>>
37674>>>>>>>            Case Else // must be nfUndefined
37674>>>>>>>                // Entrada sin contexto de navegación definido.
37674>>>>>>>                // No aplicamos comportamiento especial.
37674>>>>>>>                Case Break
37675>>>>>>>        Case End
37675>>>>>>>
37675>>>>>>>        // Actualizamos la visibilidad de botones según el modo de navegación.
37675>>>>>>>        Send SetActionButtons
37676>>>>>>>    End_Procedure
