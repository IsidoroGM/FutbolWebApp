37832>>>>>                Case Break
37833>>>>>
37833>>>>>            Case Else // must be nfUndefined
37833>>>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37833>>>>>
37833>>>>>        Case End
37833>>>>>
37833>>>>>    End_Procedure
