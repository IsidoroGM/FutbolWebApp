38492>>>                // If from main, this is a propbably a main file Select to Zoom.
38492>>>                Case Break
38493>>>
38493>>>            Case (NavigateData.eNavigateType = nfFromParent)
38496>>>                // If from parent, this is a constrained drill down.
38496>>>                Case Break
38497>>>
38497>>>            Case (NavigateData.eNavigateType = nfFromChild)
38500>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38500>>>                Case Break
38501>>>
38501>>>            Case Else // must be nfUndefined
38501>>>
38501>>>        Case End
38501>>>
38501>>>        Send SetActionButtons
38502>>>
38502>>>    End_Procedure
