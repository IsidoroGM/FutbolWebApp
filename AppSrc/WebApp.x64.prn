38503>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38503>>>                Case Break
38504>>>
38504>>>            Case Else // must be nfUndefined
38504>>>
38504>>>        Case End
38504>>>
38504>>>        Send SetActionButtons
