37792>>>        Case Begin
37792>>>            Case (NavigateData.eNavigateType = nfFromMain)
37794>>>                // If from main, this is a propbably a main file Select to Zoom.
37794>>>                Case Break
37795>>>
37795>>>            Case (NavigateData.eNavigateType = nfFromParent)
37798>>>                // If from parent, this is a constrained drill down.
37798>>>                Case Break
37799>>>
37799>>>            Case (NavigateData.eNavigateType = nfFromChild)
37802>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37802>>>                Case Break
37803>>>
37803>>>            Case Else // must be nfUndefined
37803>>>
37803>>>        Case End
37803>>>
37803>>>        Send SetActionButtons
37804>>>
37804>>>    End_Procedure
