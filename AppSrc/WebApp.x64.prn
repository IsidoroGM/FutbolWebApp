38701>>>        Procedure OnRowClick String sRowId
38704>>>            tWebNavigateData NavigateData
38704>>>            tWebNavigateData NavigateData
38704>>>            Get GetNavigateData to NavigateData
38705>>>
38705>>>            Case Begin
38705>>>                Case (NavigateData.eNavigateType = nfFromParent)
38707>>>                    // Si llegamos desde una vista padre, avanzamos al detalle de la posición seleccionada.
38707>>>                    Send NavigateForward of oZoomPosicion Self
38708>>>                    Case Break
38709>>>
38709>>>                Case (NavigateData.eNavigateType = nfFromChild)
38712>>>                    // Si la vista se usa como selector desde un Zoom hijo, devolvemos el registro seleccionado.
38712>>>                    Send NavigateClose Self
38713>>>                    Case Break
38714>>>
38714>>>                Case (NavigateData.eNavigateType = nfFromMain)
38717>>>                    // Si se usa como búsqueda principal, cerramos devolviendo la selección al invocador.
38717>>>                    Send NavigateClose Self
38718>>>                    Case Break
38719>>>
38719>>>                Case Else // must be nfUndefined
38719>>>                    // Acceso directo al listado: abrir el Zoom de la posición seleccionada.
38719>>>                    Send NavigateForward of oZoomPosicion Self
38720>>>                    Case Break
38721>>>            Case End
38721>>>        End_Procedure
