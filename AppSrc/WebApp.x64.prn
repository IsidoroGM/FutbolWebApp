38021>>>>>>>    Procedure SetActionButtons
38024>>>>>>>        tWebNavigateData NavigateData
38024>>>>>>>        tWebNavigateData NavigateData
38024>>>>>>>        Boolean bHasRecord
38024>>>>>>>        Handle hoDD
38024>>>>>>>
38024>>>>>>>        Get Server to hoDD
38025>>>>>>>        Get GetNavigateData to NavigateData
38026>>>>>>>        Get HasRecord of hoDD to bHasRecord
38027>>>>>>>
38027>>>>>>>        // Ocultamos todos los botones antes de decidir cuáles mostrar.
38027>>>>>>>        WebSet pbRender of oEditBtn to False
38028>>>>>>>        WebSet pbRender of oSaveBtn to False
38029>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38030>>>>>>>        WebSet pbRender of oDeleteBtn to False
38031>>>>>>>        WebSet pbRender of oVerEquiposBtn to False
38032>>>>>>>
38032>>>>>>>        If (NavigateData.bReadOnly) Begin
38034>>>>>>>    // En modo solo lectura solo mostramos el botón de editar.
38034>>>>>>>    WebSet pbRender of oEditBtn to True
38035>>>>>>>        End
38035>>>>>>>>
38035>>>>>>>        Else Begin
38036>>>>>>>            // En modo edición o creación mostramos guardar y cancelar.
38036>>>>>>>            WebSet pbRender of oSaveBtn to True
38037>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38038>>>>>>>        
38038>>>>>>>            // Delete solo aparece si ya hay un registro existente.
38038>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38039>>>>>>>        End
38039>>>>>>>>
38039>>>>>>>    // El botón de equipos solo debe aparecer si la liga ya existe.
38039>>>>>>>        WebSet pbRender of oVerEquiposBtn to bHasRecord
38040>>>>>>>    End_Procedure
38041>>>>>>>
