38051>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38054>>>>>>>        Case Begin
38054>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38056>>>>>>>                // Entrada desde una navegación principal.
38056>>>>>>>                // Ejemplo: SelectLiga abre ZoomLiga para consultar una liga.
38056>>>>>>>                Case Break
38057>>>>>>>
38057>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38060>>>>>>>                // Entrada desde una vista padre.
38060>>>>>>>                // Liga suele ser entidad raíz, así que normalmente no aplicamos filtros aquí.
38060>>>>>>>                Case Break
38061>>>>>>>
38061>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38064>>>>>>>                // Entrada desde una vista hija.
