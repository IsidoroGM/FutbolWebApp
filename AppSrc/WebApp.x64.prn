37876>>>    Procedure SetActionButtons
37879>>>        tWebNavigateData NavigateData
37879>>>        tWebNavigateData NavigateData
37879>>>        Boolean bHasRecord
37879>>>        Handle hoDD
37879>>>
37879>>>        Get Server to hoDD
37880>>>        Get GetNavigateData to NavigateData
37881>>>        Get HasRecord of hoDD to bHasRecord
37882>>>
37882>>>        // let's hide all buttons and then Show the ones we want
37882>>>        WebSet pbRender of oEditBtn to False
37883>>>        WebSet pbRender of oSaveBtn to False
37884>>>        WebSet pbRender of oCancelChangesBtn to False
37885>>>        WebSet pbRender of oDeleteBtn to False
37886>>>
37886>>>        If (NavigateData.bReadOnly) Begin
37888>>>            WebSet pbRender of oEditBtn to True
37889>>>        End
37889>>>>
37889>>>        Else Begin
37890>>>            WebSet pbRender of oSaveBtn to True
37891>>>            WebSet pbRender of oCancelChangesBtn to True
37892>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37893>>>        End
37893>>>>
37893>>>    End_Procedure
37894>>>
37894>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37897>>>        // Close after save
37897>>>        Send NavigateClose Self
37898>>>    End_Procedure
37899>>>
37899>>>    // this will close the view after a delete
37899>>>    Procedure OnViewDeleted Handle hoDDO
37902>>>        Send NavigateClose Self
37903>>>    End_Procedure
