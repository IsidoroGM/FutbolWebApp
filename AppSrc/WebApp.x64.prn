39249>>>            Get GetNavigateData to NavigateData
39250>>>
39250>>>            Case Begin
39250>>>                Case (NavigateData.eNavigateType = nfFromParent)
39252>>>                    // Venimos desde una vista padre: continuamos el drilldown hacia el Zoom del entrenador.
39252>>>                    Send NavigateForward of oZoomEntrenador Self
39253>>>                    Case Break
39254>>>
39254>>>                Case (NavigateData.eNavigateType = nfFromChild)
39257>>>                    // Venimos desde un Zoom hijo como b├║squeda: se devuelve el entrenador seleccionado y se cierra el Select.
39257>>>                    Send NavigateClose Self
39258>>>                    Case Break
39259>>>
39259>>>                Case (NavigateData.eNavigateType = nfFromMain)
39262>>>                    // Venimos desde una b├║squeda principal: se devuelve el entrenador seleccionado y se cierra el Select.
39262>>>                    Send NavigateClose Self
39263>>>                    Case Break
39264>>>
39264>>>                Case Else // must be nfUndefined
39264>>>                    // Entrada directa desde el men├║/dashboard: se abre el Zoom del entrenador seleccionado.
39264>>>                    Send NavigateForward of oZoomEntrenador Self
39265>>>                    Case Break
39266>>>
39266>>>            Case End
39266>>>        End_Procedure
