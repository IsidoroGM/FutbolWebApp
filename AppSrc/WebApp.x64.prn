38672>>>        // La selección de una fila debe abrir el Zoom de Posición, no otra vista Select.
38672>>>        WebRegisterPath ntNavigateForward oZoomPosicion
38678>>>
38678>>>        Procedure OnRowClick String sRowId
38681>>>            tWebNavigateData NavigateData
38681>>>            tWebNavigateData NavigateData
38681>>>            Get GetNavigateData to NavigateData
38682>>>
38682>>>            Case Begin
38682>>>                Case (NavigateData.eNavigateType = nfFromParent)
38684>>>                    // Si llegamos desde una vista padre, avanzamos al detalle de la posición seleccionada.
38684>>>                    Send NavigateForward of oZoomPosicion Self
38685>>>                    Case Break
38686>>>
38686>>>                Case (NavigateData.eNavigateType = nfFromChild)
38689>>>                    // Si la vista se usa como selector desde un Zoom hijo, devolvemos el registro seleccionado.
38689>>>                    Send NavigateClose Self
38690>>>                    Case Break
38691>>>
38691>>>                Case (NavigateData.eNavigateType = nfFromMain)
38694>>>                    // Si se usa como búsqueda principal, cerramos devolviendo la selección al invocador.
38694>>>                    Send NavigateClose Self
38695>>>                    Case Break
38696>>>
38696>>>                Case Else // must be nfUndefined
38696>>>                    // Acceso directo al listado: abrir el Zoom de la posición seleccionada.
38696>>>                    Send NavigateForward of oZoomPosicion Self
38697>>>                    Case Break
38698>>>            Case End
38698>>>        End_Procedure
38699>>>
38699>>>        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
38702>>>            // La navegación por fila abre el Zoom en modo solo lectura.
38702>>>            Move True to NavigateData.bReadOnly
38703>>>        End_Procedure
38704>>>
38704>>>    End_Object 
