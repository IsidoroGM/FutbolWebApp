38577>>>>>        tWebNavigateData NavigateData
38577>>>>>        tWebNavigateData NavigateData
38577>>>>>        Boolean bHasRecord
38577>>>>>        Handle hoDD
38577>>>>>
38577>>>>>        Get Server to hoDD
38578>>>>>        Get GetNavigateData to NavigateData
38579>>>>>        Get HasRecord of hoDD to bHasRecord
38580>>>>>
38580>>>>>        // Ocultamos todos los botones y mostramos solo los válidos según la navegación actual.
38580>>>>>        WebSet pbRender of oEditBtn to False
38581>>>>>        WebSet pbRender of oSaveBtn to False
38582>>>>>        WebSet pbRender of oCancelChangesBtn to False
38583>>>>>        WebSet pbRender of oDeleteBtn to False
38584>>>>>
38584>>>>>        If (NavigateData.bReadOnly) Begin
38586>>>>>            // Si el Zoom llega en modo consulta, solo permitimos pasar a edición.
38586>>>>>            WebSet pbRender of oEditBtn to True
38587>>>>>        End
38587>>>>>>
38587>>>>>        Else Begin
38588>>>>>            // Si el Zoom llega en modo edición o alta, mostramos acciones de mantenimiento.
38588>>>>>            WebSet pbRender of oSaveBtn to True
38589>>>>>            WebSet pbRender of oCancelChangesBtn to True
38590>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38591>>>>>        End
38591>>>>>>
38591>>>>>    End_Procedure
