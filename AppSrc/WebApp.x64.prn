37632>>>>>>>    Procedure SetActionButtons
37635>>>>>>>        tWebNavigateData NavigateData
37635>>>>>>>        tWebNavigateData NavigateData
37635>>>>>>>        Boolean bHasRecord
37635>>>>>>>        Handle hoDD
37635>>>>>>>
37635>>>>>>>        Get Server to hoDD
37636>>>>>>>        Get GetNavigateData to NavigateData
37637>>>>>>>        Get HasRecord of hoDD to bHasRecord
37638>>>>>>>
37638>>>>>>>        // Ocultamos todos los botones antes de decidir cuáles mostrar.
37638>>>>>>>        WebSet pbRender of oEditBtn to False
37639>>>>>>>        WebSet pbRender of oSaveBtn to False
37640>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37641>>>>>>>        WebSet pbRender of oDeleteBtn to False
37642>>>>>>>
37642>>>>>>>        If (NavigateData.bReadOnly) Begin
37644>>>>>>>            // En modo solo lectura solo mostramos el botón de editar.
37644>>>>>>>            WebSet pbRender of oEditBtn to True
37645>>>>>>>        End
37645>>>>>>>>
37645>>>>>>>        Else Begin
37646>>>>>>>            // En modo edición o creación mostramos guardar y cancelar.
37646>>>>>>>            WebSet pbRender of oSaveBtn to True
37647>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37648>>>>>>>
37648>>>>>>>            // Delete solo aparece si ya hay un registro existente.
37648>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37649>>>>>>>        End
37649>>>>>>>>
37649>>>>>>>    End_Procedure
