38465>>>        tWebNavigateData NavigateData
38465>>>        tWebNavigateData NavigateData
38465>>>        Boolean bHasRecord
38465>>>        Handle hoDD
38465>>>
38465>>>        Get Server to hoDD
38466>>>        Get GetNavigateData to NavigateData
38467>>>        Get HasRecord of hoDD to bHasRecord
38468>>>
38468>>>        // let's hide all buttons and then Show the ones we want
38468>>>        WebSet pbRender of oEditBtn to False
38469>>>        WebSet pbRender of oSaveBtn to False
38470>>>        WebSet pbRender of oCancelChangesBtn to False
38471>>>        WebSet pbRender of oDeleteBtn to False
38472>>>
38472>>>        If (NavigateData.bReadOnly) Begin
38474>>>            WebSet pbRender of oEditBtn to True
38475>>>        End
38475>>>>
38475>>>        Else Begin
38476>>>            WebSet pbRender of oSaveBtn to True
38477>>>            WebSet pbRender of oCancelChangesBtn to True
38478>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38479>>>        End
38479>>>>
38479>>>    End_Procedure
