38767>>>
38767>>>        Case Begin
38767>>>            Case (NavigateData.eNavigateType = nfFromParent)
38769>>>                // Entrada desde una vista padre: mantenemos visible el botón de detalle.
38769>>>                Case Break
38770>>>
38770>>>            Case (NavigateData.eNavigateType = nfFromChild)
38773>>>                // Entrada desde un Zoom hijo: la vista funciona como selector de posición.
38773>>>                Case Break
38774>>>
38774>>>            Case (NavigateData.eNavigateType = nfFromMain)
38777>>>                // Entrada como prompt/búsqueda: se oculta el detalle para devolver solo la selección.
38777>>>                WebSet pbRender of oDetailButton to False
38778>>>                Case Break
38779>>>
38779>>>            Case Else // must be nfUndefined
38779>>>                // Entrada directa al listado: permitimos abrir el Zoom desde la fila o el botón.
38779>>>
38779>>>        Case End
38779>>>
38779>>>    End_Procedure
